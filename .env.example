# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.
NODE_ENV=development
PORT=4000

# MongoDB Atlas
DATABASE_URL=mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/graphql_usuarios

# Orígenes que pueden consumir la API desde el navegador (separados por coma). Vacío = cualquiera.
CORS_ORIGINS=

# Secreto del cron diario que restaura los datos de ejemplo (Vercel lo envía automáticamente)
CRON_SECRET=
